{
    "problemMatcher": [
        {
            "owner": "gcc-problem-matcher",
            "pattern": [
                {
                    "regexp": "^(..\/)${{ BASE }}\\/?(.*?)(?<!(?:${{ SKIP }}).*):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 2,
                    "line": 4,
                    "column": 5,
                    "severity": 6,
                    "message": 7
                }
            ]
        }
    ]
}
